# ============================================================
# AI Keyboard Backend – Environment Configuration
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below.
# 3. NEVER commit .env to version control (it is in .gitignore).
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── AI Provider ──────────────────────────────────────────────
# Supported: gemini | openai | mock
# Use "mock" for local testing without spending API credits.
AI_PROVIDER=gemini

# ── Gemini API Key ───────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
# This key is ONLY read by the backend.
# It is NEVER sent to the Android application.
GEMINI_API_KEY=your_gemini_api_key_here

# ── Gemini Model ─────────────────────────────────────────────
# gemini-2.0-flash        – fast, recommended default
# gemini-2.0-flash-lite   – faster, lower cost
# gemini-1.5-flash        – stable alternative
# gemini-1.5-pro          – higher quality, slower
AI_MODEL=gemini-2.0-flash

# ── Request timeout ──────────────────────────────────────────
# Milliseconds to wait for Gemini before returning a timeout error.
AI_TIMEOUT_MS=30000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins.
# Android native apps do NOT send an Origin header, so CORS
# is only relevant for future web clients.
# Leave empty to allow all origins during local development.
ALLOWED_ORIGINS=

# ── Rate Limiting ─────────────────────────────────────────────
# RATE_LIMIT_WINDOW_MS  – sliding window in milliseconds (default: 60000 = 1 min)
# RATE_LIMIT_MAX_REQUESTS – max requests per IP per window (default: 30)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# ── Input Limits ─────────────────────────────────────────────
# MAX_TEXT_LENGTH        – max characters in the "text" field (default: 5000)
# MAX_INSTRUCTION_LENGTH – max characters in "instruction" for custom action (default: 1000)
MAX_TEXT_LENGTH=5000
MAX_INSTRUCTION_LENGTH=1000
